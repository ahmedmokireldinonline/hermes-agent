MOCK_LLM=true
DATABASE_URL=sqlite+aiosqlite:///./hermes.db
REDIS_URL=redis://localhost:6379/0
OLLAMA_URL=http://localhost:11434
MODEL_PROFILE=lite
API_KEYS=change-me
RATE_LIMIT_PER_MIN=60
MAX_STEPS=6
MAX_TASK_SECONDS=120
MAX_TASK_TOKENS=4096
MAX_RETRIES=3
WEBHOOK_ALLOW=
SKILL_SOURCE_ALLOW=raw.githubusercontent.com,github.com,gitlab.com,huggingface.co
MAX_SKILL_BYTES=200000
WORKSPACE_DIR=./workspace
ARTIFACTS_DIR=./workspace/artifacts
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=15000
# Comma-separated domains. Keep empty to allow public destinations only.
BROWSER_ALLOWED_DOMAINS=
BROWSER_MAX_PAGES=4
BROWSER_ARTIFACT_RETENTION_DAYS=7
