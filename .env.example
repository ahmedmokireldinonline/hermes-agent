ENV=dev
MOCK_LLM=true
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=sqlite+aiosqlite:///./hermes.db
REDIS_URL=redis://localhost:6379/0
OLLAMA_URL=http://host.docker.internal:11434
MODEL_PROFILE=lite
API_KEYS=change-me-only-for-dev
RATE_LIMIT_PER_MIN=60
MAX_STEPS=6
MAX_TASK_SECONDS=120
MAX_TASK_TOKENS=4096
MAX_RETRIES=3
WEBHOOK_ALLOW=
SKILL_SOURCE_ALLOW=raw.githubusercontent.com,github.com,gitlab.com,huggingface.co
SKILL_REPO_ALLOW=
MAX_SKILL_BYTES=200000
MAX_FILE_BYTES=100000
MAX_FILE_COUNT=100
REQUEST_MAX_BYTES=200000
WORKSPACE_DIR=./workspace
REVIEW_DIR=./review
QUEUE_MODE=inline
